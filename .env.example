VIDEO_PROVIDER_API_URL=
VIDEO_PROVIDER_API_KEY=
# Comma-separated iframe host allowlist for non-Telegram providers.
VIDEO_EMBED_ALLOWED_HOSTS=

# Public Telegram channel posts only. Use channel username + numeric post ID.
# Example: [{"channel":"official_channel","messageId":"123","title":"Video title","category":"News"}]
# Only embed posts you own or have permission to redistribute/display.
TELEGRAM_PUBLIC_POSTS_JSON=[]

# Legacy bot importer settings are not used by the public-channel embed integration.
